pipeline {
    agent any
    stages {
        stage('Git pull') {
            steps {
                git branch: 'main', url: 'https://github.com/djain2558-cyber/EasyCRUD.git'
            }
        }
        stage('Build') {
            steps {
                sh '''cd backend 
                  mvn clean package -DskipTests'''
            }
        }
        stage('Test') {
            steps {
                echo 'test success'
            }
        }
        stage('Deploy') {
            steps {
                echo 'deploy success'
            }
        }
    }
}
